(gitgram
  (name "blinky-badge")
  (meta
    (author "Onyx Tools")
    (license "CERN-OHL-S-2.0")
    (version "1.0.0")
  )
  (part "D1"
    (kind "led")
    (value "red")
    (footprint "LED_SMD:LED_0603_1608Metric")
    (pin "a" "1")
    (pin "k" "2")
  )
  (part "J1"
    (kind "connector")
    (value "USB-C 2.0")
    (footprint "Connector_USB:USB_C_Receptacle")
    (pin "GND" "A1")
    (pin "VBUS" "A4")
  )
  (part "R1"
    (kind "resistor")
    (value "220")
    (footprint "Resistor_SMD:R_0603_1608Metric")
    (pin "a" "1")
    (pin "b" "2")
  )
  (part "U1"
    (kind "mcu")
    (value "ATmega328P")
    (footprint "Package_QFP:TQFP-32_7x7mm_P0.8mm")
    (pin "GND" "3")
    (pin "VCC" "4")
    (pin "PB0" "12")
    (pin "PA1" "31")
    (pin "PA0" "32")
  )
  (net "GND"
    (class "ground")
    (node "D1" "k")
    (node "J1" "GND")
    (node "U1" "GND")
  )
  (net "LED"
    (class "signal")
    (node "D1" "a")
    (node "R1" "b")
    (node "U1" "PA0")
  )
  (net "SPARE"
    (class "signal")
    (node "U1" "PA1")
    (node "U1" "PB0")
  )
  (net "VCC"
    (class "power")
    (node "J1" "VBUS")
    (node "R1" "a")
    (node "U1" "VCC")
  )
)
